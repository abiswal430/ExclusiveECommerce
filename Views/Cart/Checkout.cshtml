@model List<ExclusiveMVC.Models.Cart>

<h2>🧾 Checkout</h2>

<form asp-controller="Order" asp-action="PlaceOrder" method="post">

    <!-- CUSTOMER DETAILS -->
    <div class="mb-3">
        <label>Name</label>
        <input type="text" name="name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Address</label>
        <input type="text" name="address" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>State</label>
        <input type="text" name="state" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>City</label>
        <input type="text" name="city" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Pin Code</label>
        <input type="text" name="pincode" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Mobile Number</label>
        <input type="text" name="phone" class="form-control" required />
    </div>

    <hr />

    <!-- PAYMENT -->
    <h4>💳 Payment Method</h4>

    <div class="form-check">
        <input type="radio" name="paymentMethod" value="Card" checked onclick="showPayment('card')" />
        <label>Card</label>
    </div>

    <div id="cardSection" class="border p-3 mt-2">
        <input class="form-control mb-2" placeholder="Card Number" />
        <input class="form-control mb-2" placeholder="Expiry Date" />
        <input class="form-control mb-2" placeholder="CVV" />
    </div>

    <div class="form-check mt-3">
        <input type="radio" name="paymentMethod" value="UPI" onclick="showPayment('upi')" />
        <label>UPI</label>
    </div>

    <div id="upiSection" class="border p-3 mt-2" style="display:none;">
        <input class="form-control" placeholder="example@upi" />
    </div>

    <div class="form-check mt-3">
        <input type="radio" name="paymentMethod" value="NetBanking" onclick="showPayment('net')" />
        <label>Net Banking</label>
    </div>

    <div id="netSection" class="border p-3 mt-2" style="display:none;">
        <select class="form-control">
            <option value="">Select Bank</option>
            <option>SBI</option>
            <option>HDFC</option>
            <option>ICICI</option>
            <option>AXIS</option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Place Order
    </button>

</form>

<!-- ORDER SUMMARY -->
<hr />

<h4>Your Order</h4>

@foreach (var item in Model)
{
    <p>@item.Name - ₹ @(item.Price * item.Quantity)</p>
}

<h3>Total: ₹ @Model.Sum(x => x.Price * x.Quantity)</h3>

<script>
function showPayment(type) {
    document.getElementById("cardSection").style.display = "none";
    document.getElementById("upiSection").style.display = "none";
    document.getElementById("netSection").style.display = "none";

    if (type === "card") document.getElementById("cardSection").style.display = "block";
    if (type === "upi") document.getElementById("upiSection").style.display = "block";
    if (type === "net") document.getElementById("netSection").style.display = "block";
}
</script>