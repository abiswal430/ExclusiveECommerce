@model List<ExclusiveMVC.Models.ApiProduct>

<h2 class="mb-4 fw-bold text-center">🌐 API Products</h2>

<!-- ✅ SUCCESS MESSAGE -->
@if (TempData["success"] != null)
{
    <script>
        setTimeout(() => {
            alert("✅ @TempData["success"]");
        }, 300);
    </script>
}

<div class="row">

@foreach (var item in Model)
{
    <div class="col-md-4 mb-4">

        <div class="card p-3 text-center shadow">

            <!-- IMAGE -->
            <img src="@item.image" height="200" style="object-fit:contain;" />

            <!-- TITLE -->
            <h6 class="mt-2">@item.title</h6>

            <!-- PRICE -->
            <p class="text-danger fw-bold">
                ₹ @(item.price * 83)
            </p>

            <!-- 🔢 QUANTITY SELECT -->
            <select id="qty_@item.id" class="form-control mb-2">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </select>

            <!-- 🛒 ADD BUTTON -->
            <button id="btn_@item.id"
                    class="btn btn-success btn-sm"
                    onclick="addToCart(@item.id, '@item.title', @item.price, '@item.image')">
                🛒 Add to Cart
            </button>

        </div>

    </div>
}

</div>

<!-- 🔥 JAVASCRIPT -->
<script>
function addToCart(id, name, price, image) {

    let qty = document.getElementById("qty_" + id).value;
    let btn = document.getElementById("btn_" + id);

    // 🔒 Disable button + show loading
    btn.disabled = true;
    btn.innerText = "Adding...";

    // ✅ SAFE URL ENCODING
    let url = `/Cart/AddFromApi?name=${encodeURIComponent(name)}&price=${price * 83}&image=${encodeURIComponent(image)}&qty=${qty}`;

    window.location.href = url;
}
</script>

<!-- 🎨 STYLE -->
<style>
.card {
    border-radius: 12px;
    transition: 0.3s;
}

.card:hover {
    transform: scale(1.03);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
}

select {
    border-radius: 8px;
}

button {
    border-radius: 8px;
}
</style>